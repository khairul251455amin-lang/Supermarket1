rules_version = '2';

// Supermarket Multi-Vendor Marketplace - Storage Security Rules
// Restricts file types to JPG, JPEG, PNG, WEBP and strictly caps size at 200 KB (204,800 bytes).
// Isolates seller paths so sellers can only write/delete their own assets.

service firebase.storage {
  match /b/{bucket}/o {
    
    // Auth Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isSellerOwner(sellerId) {
      return isSignedIn() && request.auth.uid == sellerId;
    }

    // Strict 200 KB maximum validation and image MIME type whitelist
    function isValidImagePayload() {
      return request.resource != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size <= 200 * 1024; // 204,800 bytes maximum
    }

    // 1. Shop Logo Storage: "shops/{sellerId}/logo"
    // Public read so shoppers can view verified seller logos
    // Seller-only upload and replacement with 200 KB max
    match /shops/{sellerId}/logo {
      allow read: if true;
      allow write: if isSellerOwner(sellerId) && isValidImagePayload();
      allow delete: if isSellerOwner(sellerId);
    }

    // 2. Product Images Storage: "products/{sellerId}/{productId}/{imageName}"
    // Exactly two photos allowed per product: image1 and image2
    // Public read for customer catalog and product detail views
    // Seller-only write and delete with 200 KB max limit
    match /products/{sellerId}/{productId}/{imageName} {
      allow read: if true;
      allow write: if isSellerOwner(sellerId) 
                   && (imageName == 'image1' || imageName == 'image2')
                   && isValidImagePayload();
      allow delete: if isSellerOwner(sellerId);
    }

    // Default catch-all deny rule for any unspecified paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
