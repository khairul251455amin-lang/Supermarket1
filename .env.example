# ==============================================================================
# Required: Firebase Web App Client Configuration
# ==============================================================================
# Copy this file to ".env" and fill in values from your Firebase Console:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY="your_firebase_web_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_APP_ID="1:your_sender_id:web:your_web_app_id"

# Required: Firestore Database ID ("(default)" for standard newly created projects)
VITE_FIREBASE_DATABASE_ID="(default)"

# ==============================================================================
# Optional: Local Firebase Emulator Mode
# ==============================================================================
# Set to "true" only when running the Firebase Local Emulator Suite (npm run emulators)
VITE_FIREBASE_USE_EMULATORS="false"

# ==============================================================================
# Optional: Marketplace Branding, Currency & Delivery Defaults
# ==============================================================================
VITE_MARKETPLACE_NAME="Supermarket"
VITE_CURRENCY_CODE="USD"
VITE_CURRENCY_SYMBOL="$"
VITE_SUPPORT_EMAIL="support@example.com"
VITE_SUPPORT_PHONE="+1 (555) 010-2026"
VITE_MARKETPLACE_HUB="Central Marketplace Hub"
VITE_FREE_DELIVERY_THRESHOLD="50"
VITE_STANDARD_DELIVERY_FEE="5"
VITE_ANNOUNCEMENT_TEXT="Discover local sellers • Easy shopping • Cash on Delivery"
VITE_SHOW_ANNOUNCEMENT_BAR="true"
